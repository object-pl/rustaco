{
  "name": "rustaco",
  "version": "0.3.0",
  "description": "A code editor for the browser, written in Rust: syntax highlighting for 20 languages, multi-cursor editing, folding, minimap",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/object-pl/rustaco.git" },
  "type": "module",
  "main": "./rustaco.js",
  "types": "./rustaco.d.ts",
  "exports": {
    ".": {
      "types": "./rustaco.d.ts",
      "default": "./rustaco.js"
    },
    "./lsp": {
      "types": "./lsp.d.ts",
      "default": "./lsp.js"
    },
    "./diff": {
      "types": "./diff.d.ts",
      "default": "./diff.js"
    }
  },
  "files": [
    "rustaco.js",
    "rustaco-worker.js",
    "languages.js",
    "suggest.js",
    "features.js",
    "lsp.js",
    "diff.js",
    "webgl-text.js",
    "rustaco.d.ts",
    "lsp.d.ts",
    "diff.d.ts",
    "favicon.ico",
    "pkg/**/*.js",
    "pkg/**/*.wasm",
    "pkg/THIRD_PARTY.md",
    "pkg/licenses/**",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": ["editor", "code-editor", "wasm", "syntax-highlighting", "tree-sitter"]
}
